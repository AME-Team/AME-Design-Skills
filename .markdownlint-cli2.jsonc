// markdownlint-cli2 設定（AME-Design-Skills）
//
// 既定ルール（markdownlint default）を全有効化。
// MD013（行長）は日本語の説明文・表・元コード由来の長い行が多いため無効化する。
// それ以外は default のまま厳格に維持する。
//
// 実行:     markdownlint-cli2 "**/*.md"
// 自動修正: markdownlint-cli2 --fix "**/*.md"
{
  "config": {
    "default": true,
    // 行長制限のみ無効（全角文字も1桁換算で機械的折返しが困難なため）。
    "MD013": false
  },
  // リポジトリ内の全 Markdown を対象（README.md / .claude/skills/**/*.md 含む）。
  "globs": ["**/*.md"],
  // vendored レビューシステム本体は上流で既に lint 済みのため除外。
  "ignores": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/.venv/**",
    "ame_ai_review_system/**"
  ]
}
